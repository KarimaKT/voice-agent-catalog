{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.26/MicrosoftTeams.schema.json",
    "manifestVersion": "1.26",
    "version": "1.2.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "Voice Agent Catalog",
        "websiteUrl": "${{TAB_ENDPOINT}}",
        "privacyUrl": "${{TAB_ENDPOINT}}/privacy",
        "termsOfUseUrl": "${{TAB_ENDPOINT}}/terms"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Voice Agent Catalog",
        "full": "Voice Agent Catalog"
    },
    "description": {
        "short": "Talk with catalog-managed Copilot agents.",
        "full": "Select a Copilot Studio agent and converse using text, speech, or a configurable real-time avatar."
    },
    "accentColor": "#FFFFFF",
    "bots": [],
    "composeExtensions": [],
    "staticTabs": [
        {
            "entityId": "index0",
            "name": "Voice Agent Catalog",
            "contentUrl": "${{TAB_ENDPOINT}}/tabs/home",
            "websiteUrl": "${{TAB_ENDPOINT}}/tabs/home",
            "scopes": [
                "personal"
            ]
        }
    ],
    "permissions": [
        "identity"
    ],
    "devicePermissions": [
        "media"
    ],
    "validDomains": [
        "${{TAB_DOMAIN}}"
    ]
}