# Copy this file to .env.dev and provide values for your tenant and subscription.
# .env.dev is intentionally excluded from Git because Agents Toolkit writes
# generated tenant and resource identifiers into it.

TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

AZURE_SUBSCRIPTION_ID=<azure-subscription-guid>
AZURE_RESOURCE_GROUP_NAME=<dedicated-resource-group>
AZURE_LOCATION=<azure-region>
RESOURCE_SUFFIX=<globally-unique-short-suffix>

COPILOT_ENVIRONMENT_ID=<copilot-studio-environment-guid>
COPILOT_SCHEMA_NAME=<published-agent-schema-name>

# Generated during provisioning.
TEAMS_APP_ID=
AAD_APP_CLIENT_ID=
AAD_APP_OBJECT_ID=
AAD_APP_TENANT_ID=
AAD_APP_OAUTH_AUTHORITY=
AAD_APP_OAUTH_AUTHORITY_HOST=
AZURE_APP_SERVICE_RESOURCE_ID=
TAB_ENDPOINT=
